Copy to `.env.local` (Next.js) and `.env` (worker/scripts). `pnpm worker`, `pnpm db:migrate`, and `pnpm invite:create` load both files automatically.
# Never commit real secrets.

# --- App ---
APP_BASE_URL=http://localhost:3000
NODE_ENV=development
# 32+ random bytes. Required at runtime for signed session cookies.
SESSION_SECRET=replace-with-a-long-random-string
# Comma-separated emails that receive the admin role on invite redeem / sign-in.
ADMIN_EMAILS=you@example.com

# --- Postgres ---
# Required in live mode. In PROVIDER_MODE=stub you can leave this empty for
# cookie-only invite/session product review (no Redis/Postgres).
DATABASE_URL=postgres://cast:cast@localhost:5432/cast

# Known stub invite when DATABASE_URL is unset (default: castreview).
# REVIEW_INVITE_CODE=castreview
# Stub review also seeds fictional demo packs Mara (Locked) and Iris (Draft).
# Drop 8–20 fictional Soul ID refs later under public/demo/refs/{mara,iris}/.

# --- Redis (BullMQ + live-mode enqueue rate limits) ---
REDIS_URL=redis://localhost:6379

# --- Object storage (Cloudflare R2 / any S3-compatible API) ---
# If unset, Stage 1 writes stills/refs to local `.data/storage`.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=cast-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# --- Providers ---
# stub = no outbound provider calls (local vertical-slice testing)
# live = call Venice / RunPod when keys are present
PROVIDER_MODE=stub
# Optional stub-only failure injector for Train / Generate retry tests (ignored in live).
# succeed | fail-generate | timeout-generate | provider-error-generate | retry-then-succeed
# | missing-adapter | fail-train | timeout-train | no-adapter | queue-stall
STUB_JOB_SCENARIO=succeed
# venice (default generateStill) | runpod (fallback) | sister (reserved slot)
GENERATE_STILL_PROVIDER=venice
TRAIN_PACK_PROVIDER=runpod

# Venice — generateStill only. Venice has no Soul-ID / train API.
# Flip stub → live Venice: PROVIDER_MODE=live, GENERATE_STILL_PROVIDER=venice,
# and connect a key. Preferred: Studio Settings → Connect Venice (encrypted in
# Postgres; worker reads it without redeploy). Fallback: VENICE_API_KEY here or
# in Vercel env (needs deploy/env sync). Leave PROVIDER_MODE=stub for preview
# (no outbound generateStill). Disconnect in Settings clears the stored key.
VENICE_API_KEY=
VENICE_API_BASE_URL=https://api.venice.ai/api/v1
# Default: lustify-v8 (Private catalog listing, uncensored photoreal character stills).
# List image models: GET $VENICE_API_BASE_URL/models?type=image
VENICE_IMAGE_MODEL=lustify-v8
# Cast policy preflight (fictional adult, 18+) is the lock. Venice safe_mode blurs
# adult stills — keep false unless you explicitly want that blur.
VENICE_SAFE_MODE=false

# RunPod + Comfy — trainPack (+ generateStill when a Soul ID adapter is stored, and Venice fallback)
# Flip stub → live Train (Soul ID): PROVIDER_MODE=live, TRAIN_PACK_PROVIDER=runpod,
# RUNPOD_API_KEY, and RUNPOD_TRAIN_ENDPOINT_ID. Leave PROVIDER_MODE=stub for preview
# (placeholder adapter, no outbound /run). Venice has no train API — do not set
# TRAIN_PACK_PROVIDER=venice. Restart the Next app AND `pnpm worker` after flipping.
# R2/S3 (S3_ENDPOINT + keys) recommended so live /run includes 1-hour signed GET
# URLs for refs. Local `.data/storage` sends object keys only.
RUNPOD_API_KEY=
RUNPOD_API_BASE_URL=https://api.runpod.ai/v2
RUNPOD_TRAIN_ENDPOINT_ID=
RUNPOD_GENERATE_ENDPOINT_ID=

# Sister private-AI company adapter (not wired as a default)
SISTER_API_KEY=
SISTER_API_BASE_URL=
